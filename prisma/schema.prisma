// prisma/schema.prisma – core models for AquaGrow ERP

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["orderByRelation"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────────
// Core authentication & RBAC models
// ────────────────────────────────────────────────
model User {
  id            String   @id @default(uuid())
  email         String?  @unique
  phoneNumber   String   @unique
  name          String
  passwordHash  String
  role          Role
  // timestamps
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  // audit relationship
  auditLogs     AuditLog[] @relation("UserAudits")
}

enum Role {
  SUPER_ADMIN
  FINANCE_ADMIN
  OPERATIONS_ADMIN
  SALES_ADMIN
  SUPPORT_ADMIN
  INVENTORY_ADMIN
  TECHNICAL_ADMIN
  HR_ADMIN
  STAFF          // generic shop staff
  FARMER
}

// Permissions are stored as a matrix but also exposed via code constants.
model Permission {
  id        Int      @id @default(autoincrement())
  action    String   // e.g., "viewPurchaseCost", "editSellingRate"
  role      Role
  // timestamps
  createdAt DateTime @default(now())
}

// ────────────────────────────────────────────────
// Audit log for any create / update / delete operation
// ────────────────────────────────────────────────
model AuditLog {
  id         Int      @id @default(autoincrement())
  entity     String   // table name, e.g., "Invoice", "Receipt"
  entityId   String   // primary key of the entity
  action     String   // CREATE, UPDATE, DELETE
  changedBy  String   // user id
  oldValue   Json?    // optional snapshot of previous state
  newValue   Json?    // optional snapshot of new state
  createdAt  DateTime @default(now())
  // relation to the user who performed the action
  user       User?    @relation("UserAudits", fields: [changedBy], references: [id])
}

// ────────────────────────────────────────────────
// Placeholder tables for later extension (products, batches, etc.)
// ────────────────────────────────────────────────
model Product {
  id               String   @id @default(uuid())
  brand            String
  code             String   @unique
  name             String
  category         String   // Feed, Medicine, Mineral, Equipment, Other
  packSize         Int
  packUnit         String   // e.g., "kg", "l", "bag"
  baseUnit         String   // canonical unit for stock calculations
  mrp              Decimal
  approvedRate     Decimal
  sellingDiscount  Decimal? // optional percentage discount
  status           String   @default("active")
  // timestamps
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Batch {
  id            String   @id @default(uuid())
  productId     String
  product       Product @relation(fields: [productId], references: [id])
  batchNumber   String
  expiryDate    DateTime?
  quantityBase  Decimal   // stored in base unit
  // timestamps
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Additional models (Farmer, Pond, Crop, Invoice, etc.) will be added in later migrations.
